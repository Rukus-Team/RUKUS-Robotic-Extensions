{
  "Module": {
    "prefix": "module",
    "description": "RAPID module skeleton",
    "body": [
      "MODULE ${1:${TM_FILENAME_BASE}}",
      "  ${0}",
      "ENDMODULE"
    ]
  },
  "Procedure": {
    "prefix": "proc",
    "description": "PROC ... ENDPROC",
    "body": [
      "PROC ${1:name}(${2})",
      "  ${0}",
      "ENDPROC"
    ]
  },
  "Function": {
    "prefix": "func",
    "description": "FUNC ... RETURN ... ENDFUNC",
    "body": [
      "FUNC ${1:num} ${2:name}(${3})",
      "  ${0}",
      "  RETURN ${4:0};",
      "ENDFUNC"
    ]
  },
  "Trap": {
    "prefix": "trap",
    "description": "TRAP ... ENDTRAP (connect it with CONNECT intno WITH name)",
    "body": [
      "TRAP ${1:name}",
      "  ${0}",
      "ENDTRAP"
    ]
  },
  "Error handler": {
    "prefix": "error",
    "description": "ERROR handler at the end of a routine",
    "body": [
      "ERROR",
      "  IF ERRNO = ${1:ERR_WAIT_MAXTIME} THEN",
      "    ${2:RETRY};",
      "  ENDIF"
    ]
  },
  "IF": {
    "prefix": "if",
    "body": ["IF ${1:condition} THEN", "  ${0}", "ENDIF"]
  },
  "FOR": {
    "prefix": "for",
    "body": ["FOR ${1:i} FROM ${2:1} TO ${3:10} DO", "  ${0}", "ENDFOR"]
  },
  "WHILE": {
    "prefix": "while",
    "body": ["WHILE ${1:condition} DO", "  ${0}", "ENDWHILE"]
  },
  "TEST": {
    "prefix": "test",
    "body": ["TEST ${1:value}", "CASE ${2:1}:", "  ${3}", "DEFAULT:", "  ${0}", "ENDTEST"]
  },
  "MoveJ": {
    "prefix": "movej",
    "body": ["MoveJ ${1:p10}, ${2:v1000}, ${3:z50}, ${4:tool0}\\WObj:=${5:wobj0};"]
  },
  "MoveL": {
    "prefix": "movel",
    "body": ["MoveL ${1:p10}, ${2:v500}, ${3:fine}, ${4:tool0}\\WObj:=${5:wobj0};"]
  },
  "MoveAbsJ": {
    "prefix": "moveabsj",
    "body": ["MoveAbsJ ${1:jHome}\\NoEOffs, ${2:v1000}, ${3:fine}, ${4:tool0};"]
  },
  "robtarget": {
    "prefix": "robtarget",
    "description": "CONST robtarget with unused external axes",
    "body": ["CONST robtarget ${1:p10}:=[[${2:0},${3:0},${4:0}],[1,0,0,0],[0,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];"]
  }
}
