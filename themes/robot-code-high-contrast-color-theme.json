    "contrastBorder": "#6fc3df",
    "contrastActiveBorder": "#ffd23f",
    "editor.background": "#000000",
    "editor.foreground": "#ffffff",
    "editorLineNumber.foreground": "#a0a0a0",
    "editorLineNumber.activeForeground": "#ffd23f",
    "editor.lineHighlightBackground": "#1a1a1a",
    "editor.lineHighlightBorder": "#ffd23f",
    "editor.selectionBackground": "#3a5a8f",
    "editorCursor.foreground": "#ffd23f",
    "editorInlayHint.foreground": "#d0d0d0",
    "editorInlayHint.background": "transparent",
    "editorInlayHint.parameterForeground": "#d0d0d0",
    "editorInlayHint.parameterBackground": "transparent",
    "editorInlayHint.typeForeground": "#d0d0d0",
    "editorInlayHint.typeBackground": "transparent",
    "editorCodeLens.foreground": "#c0c0c0",
    "activityBar.background": "#000000",
    "activityBar.foreground": "#ffffff",
    "activityBarBadge.background": "#ffd23f",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#000000",
    "statusBar.background": "#000000",
    "statusBar.foreground": "#ffffff",
    "titleBar.activeBackground": "#000000",
    "titleBar.activeForeground": "#ffffff",
    "tab.activeBorderTop": "#ffd23f",
    "focusBorder": "#ffd23f",
    "list.activeSelectionBackground": "#3a5a8f",
    "list.activeSelectionForeground": "#ffffff",
    "editorWidget.background": "#000000",
    "input.background": "#000000",
    "badge.background": "#ffd23f",
    "badge.foreground": "#000000",
    "charts.orange": "#ffb86b",
    "charts.yellow": "#ffd23f",
    "charts.blue": "#9ecbff",
    "charts.red": "#ff5555",
    "charts.purple": "#e39dff",
    "charts.green": "#b5f27a",
    "charts.foreground": "#ffffff",
    "charts.lines": "#a0a0a0",
    "terminal.ansiCyan": "#7fe3f0"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line.exclamation.tp",
        "comment.line.double-dash.karel"
      ],
      "settings": {
        "foreground": "#7cc37c",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.line.double-slash.remark.tp"
      ],
      "settings": {
        "foreground": "#9a9a9a",
        "fontStyle": "italic strikethrough"
      }
    },
    {
      "scope": [
        "constant.numeric.line-number.tp",
        "punctuation.separator.line-number.tp",
        "punctuation.separator.continuation.tp"
      ],
      "settings": {
        "foreground": "#a0a0a0"
      }
    },
    {
      "scope": [
        "keyword.control.section.tp",
        "keyword.control.section.karel",
        "keyword.control.program.karel"
      ],
      "settings": {
        "foreground": "#e39dff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function.program.tp",
        "entity.name.function.program.karel"
      ],
      "settings": {
        "foreground": "#ffd23f",
        "fontStyle": "bold"
      }
    },
    {
