  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line.exclamation.tp",
        "comment.line.double-dash.karel"
      ],
      "settings": {
        "foreground": "#1e6a12",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.line.double-slash.remark.tp"
      ],
      "settings": {
        "foreground": "#5a5a5a",
        "fontStyle": "italic strikethrough"
      }
    },
    {
      "scope": [
        "constant.numeric.line-number.tp",
        "punctuation.separator.line-number.tp",
        "punctuation.separator.continuation.tp"
      ],
      "settings": {
        "foreground": "#5a5a5a"
      }
    },
    {
      "scope": [
        "keyword.control.section.tp",
        "keyword.control.section.karel",
        "keyword.control.program.karel"
      ],
      "settings": {
        "foreground": "#5c1a8a",
        "fontStyle": "bold"
      }
    },
    {
