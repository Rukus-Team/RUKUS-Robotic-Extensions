    "editorLineNumber.foreground": "#5a5a5a",
    "editorLineNumber.activeForeground": "#000000",
    "editor.lineHighlightBackground": "#f0f0f0",
    "editor.lineHighlightBorder": "#0f4a85",
    "editor.selectionBackground": "#a8c7fa",
    "editorCursor.foreground": "#000000",
    "editorInlayHint.foreground": "#3c3c3c",
    "editorInlayHint.background": "transparent",
    "editorInlayHint.parameterForeground": "#3c3c3c",
    "editorInlayHint.parameterBackground": "transparent",
    "editorInlayHint.typeForeground": "#3c3c3c",
    "editorInlayHint.typeBackground": "transparent",
    "editorCodeLens.foreground": "#3c3c3c",
    "activityBar.background": "#ffffff",
    "activityBar.foreground": "#000000",
    "activityBarBadge.background": "#0f4a85",
    "activityBarBadge.foreground": "#ffffff",
    "sideBar.background": "#ffffff",
    "statusBar.background": "#ffffff",
    "statusBar.foreground": "#000000",
    "titleBar.activeBackground": "#ffffff",
    "titleBar.activeForeground": "#000000",
    "tab.activeBorderTop": "#0f4a85",
    "focusBorder": "#0f4a85",
    "list.activeSelectionBackground": "#a8c7fa",
    "list.activeSelectionForeground": "#000000",
    "editorWidget.background": "#ffffff",
    "input.background": "#ffffff",
    "badge.background": "#0f4a85",
    "badge.foreground": "#ffffff",
    "charts.orange": "#8a4200",
    "charts.yellow": "#6b4d00",
    "charts.blue": "#0f4a85",
    "charts.red": "#a30000",
    "charts.purple": "#5c1a8a",
    "charts.green": "#1e6a12",
    "charts.foreground": "#000000",
    "charts.lines": "#5a5a5a",
    "terminal.ansiCyan": "#005a63"
