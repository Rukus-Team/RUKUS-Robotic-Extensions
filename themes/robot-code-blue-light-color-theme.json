{
  "name": "Robot Code Blue Light",
  "type": "light",
  "colors": {
    "editor.background": "#f9fbff",
    "editor.foreground": "#1f2933",
    "editorLineNumber.foreground": "#9aa5b1",
    "editorLineNumber.activeForeground": "#1f63b0",
    "editor.lineHighlightBackground": "#edf2f9",
    "editor.selectionBackground": "#cfe1f7",
    "editorCursor.foreground": "#1f63b0",
    "editorInlayHint.foreground": "#6b7280",
    "editorInlayHint.background": "transparent",
    "editorInlayHint.parameterForeground": "#6b7280",
    "editorInlayHint.parameterBackground": "transparent",
    "editorInlayHint.typeForeground": "#6b7280",
    "editorInlayHint.typeBackground": "transparent",
    "editorCodeLens.foreground": "#8a919b",
    "activityBar.background": "#e9f0f9",
    "activityBar.foreground": "#1f2933",
    "activityBarBadge.background": "#1f63b0",
    "activityBarBadge.foreground": "#ffffff",
    "sideBar.background": "#f0f5fb",
    "statusBar.background": "#e9f0f9",
    "statusBar.foreground": "#1f2933",
    "titleBar.activeBackground": "#e9f0f9",
    "titleBar.activeForeground": "#1f2933",
    "tab.activeBorderTop": "#1f63b0",
    "focusBorder": "#1f63b0",
    "list.activeSelectionBackground": "#cfe1f7",
    "list.activeSelectionForeground": "#1f2933",
    "editorWidget.background": "#f6f9fd",
    "input.background": "#ffffff",
    "badge.background": "#1f63b0",
    "badge.foreground": "#ffffff",
    "charts.orange": "#b35c00",
    "charts.yellow": "#9a6700",
    "charts.blue": "#0b5ea8",
    "charts.red": "#c62828",
    "charts.purple": "#7a3e9d",
    "charts.green": "#2e7d32",
    "charts.foreground": "#1f2933",
    "charts.lines": "#9aa5b1",
    "terminal.ansiCyan": "#0e7c86"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line.exclamation.tp",
        "comment.line.double-dash.karel"
      ],
      "settings": {
        "foreground": "#3f7a2a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.line.double-slash.remark.tp"
      ],
      "settings": {
        "foreground": "#8a919b",
        "fontStyle": "italic strikethrough"
      }
    },
    {
      "scope": [
        "constant.numeric.line-number.tp",
        "punctuation.separator.line-number.tp",
        "punctuation.separator.continuation.tp"
      ],
      "settings": {
        "foreground": "#9aa5b1"
      }
    },
    {
      "scope": [
        "keyword.control.section.tp",
        "keyword.control.section.karel",
        "keyword.control.program.karel"
      ],
      "settings": {
        "foreground": "#7a3e9d",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function.program.tp",
        "entity.name.function.program.karel"
      ],
      "settings": {
        "foreground": "#1f63b0",
        "fontStyle": "bold"
      }
    },
    {
