    { "scope": ["string"], "settings": { "foreground": "#98c379" } },
    { "scope": ["string.quoted.single.config.tp"], "settings": { "foreground": "#a5d6ff" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#d19a66" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#abb2bf" } },
    { "scope": ["punctuation.terminator.tp"], "settings": { "foreground": "#4b5563" } },
