    { "scope": ["invalid.deprecated.untaught.tp"], "settings": { "foreground": "#f14c4c", "fontStyle": "bold" } },
    { "scope": ["constant.language.io-state.tp"], "settings": { "foreground": "#7b8794", "fontStyle": "italic" } },
    { "name": "RAPID: like keyword.control.karel", "scope": ["keyword.control.rapid"], "settings": { "foreground": "#c678dd" } },
    { "name": "RAPID: like keyword.control.section.karel", "scope": ["keyword.control.handler.rapid", "keyword.other.module.rapid", "keyword.other.routine.rapid", "keyword.other.record.rapid"], "settings": { "foreground": "#c678dd", "fontStyle": "bold" } },
    { "name": "RAPID: like entity.name.function.program.karel", "scope": ["entity.name.type.module.rapid"], "settings": { "foreground": "#8cc1fa", "fontStyle": "bold" } },
    { "name": "RAPID: like entity.name.function.routine.karel", "scope": ["entity.name.function.rapid"], "settings": { "foreground": "#8cc1fa", "fontStyle": "bold" } },
    { "name": "RAPID: like entity.name.import.karel", "scope": ["entity.name.type.record.rapid"], "settings": { "foreground": "#e5c07b" } },
    { "name": "RAPID: like support.function.builtin.karel", "scope": ["support.function.instruction.rapid", "support.function.builtin.rapid"], "settings": { "foreground": "#dcdcaa" } },
    { "name": "RAPID: like storage.type.karel", "scope": ["support.type.rapid"], "settings": { "foreground": "#56b6c2" } },
    { "name": "RAPID: like storage.modifier.program-type.tp", "scope": ["storage.type.rapid", "storage.modifier.rapid"], "settings": { "foreground": "#e5c07b" } },
    { "name": "RAPID: like storage.modifier.motion-option.tp", "scope": ["storage.modifier.module-attribute.rapid", "variable.parameter.optional.rapid", "punctuation.definition.parameter.rapid"], "settings": { "foreground": "#56b6c2" } },
    { "name": "RAPID: like variable.language.system.karel", "scope": ["constant.other.rapid"], "settings": { "foreground": "#e06c75" } },
    { "name": "RAPID: like variable.other.attribute.tp", "scope": ["keyword.other.header.rapid", "constant.other.header.rapid", "punctuation.definition.header.rapid"], "settings": { "foreground": "#7b8794" } },
    { "name": "RAPID: like string.quoted.single.config.tp", "scope": ["constant.character.escape.rapid"], "settings": { "foreground": "#a5d6ff" } },
    { "name": "RAPID: like entity.name.label.definition.tp", "scope": ["entity.name.label.rapid"], "settings": { "foreground": "#8cc1fa", "fontStyle": "bold underline" } },
    { "name": "RAPID: like invalid.deprecated.untaught.tp", "scope": ["invalid.placeholder.rapid"], "settings": { "foreground": "#f14c4c", "fontStyle": "bold" } },
    { "name": "RAPID: like entity.name.variable.va", "scope": ["variable.other.declaration.rapid"], "settings": { "foreground": "#61afef" } },
    { "name": "RAPID: like punctuation.terminator.tp", "scope": ["punctuation.separator.rapid"], "settings": { "foreground": "#4b5563" } }
