{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FANUC TP",
  "scopeName": "source.fanuc.tp",
  "patterns": [
    {
      "include": "#section-prog"
    },
    {
      "include": "#section-marker"
    },
    {
      "include": "#attr-line"
    },
    {
      "include": "#pos-block"
    },
    {
      "include": "#extended-comment"
    },
    {
      "include": "#comment-line"
    },
    {
      "include": "#instruction-line"
    },
    {
      "include": "#continuation-line"
    },
    {
      "include": "#appl-line"
    }
  ],
  "repository": {
    "section-prog": {
      "match": "^(/PROG)\\s+([A-Za-z0-9_\\-]+)\\s*(Macro|Cond|Collection|System)?\\s*$",
      "captures": {
        "1": {
          "name": "keyword.control.section.tp"
        },
        "2": {
          "name": "entity.name.function.program.tp"
        },
        "3": {
          "name": "storage.modifier.program-type.tp"
        }
      }
    },
    "section-marker": {
      "match": "^(/ATTR|/APPL|/MN|/POS|/END)\\b.*$",
      "captures": {
        "1": {
          "name": "keyword.control.section.tp"
        }
      }
    },
    "attr-line": {
      "match": "^(TCD:)?\\s*([A-Z_]+)\\s*(=)\\s*(.*?)\\s*(;|,)?\\s*$",
      "captures": {
        "1": {
          "name": "keyword.other.attribute.tp"
        },
        "2": {
          "name": "variable.other.attribute.tp"
        },
        "3": {
          "name": "keyword.operator.assignment.tp"
        },
        "4": {
          "patterns": [
            {
              "include": "#attr-value"
            }
          ]
        },
        "5": {
          "name": "punctuation.terminator.tp"
        }
      }
    },
    "attr-value": {
      "patterns": [
        {
          "match": "\\b(DATE)\\s+(\\d{2}-\\d{2}-\\d{2})\\s+(TIME)\\s+(\\d{2}:\\d{2}:\\d{2})",
          "captures": {
            "1": {
              "name": "keyword.other.tp"
            },
            "2": {
              "name": "constant.numeric.date.tp"
            },
            "3": {
              "name": "keyword.other.tp"
            },
            "4": {
              "name": "constant.numeric.time.tp"
            }
          }
        },
        {
          "include": "#string"
        },
        {
          "match": "\\b(READ_WRITE|READ_ONLY|ASCBIN|MNEDITOR|COMMENT)\\b",
          "name": "constant.language.attr.tp"
        },
        {
          "match": "[0-9*,]+",
          "name": "constant.numeric.tp"
        },
        {
          "match": "[A-Za-z_][A-Za-z0-9_]*",
          "name": "constant.other.tp"
        }
      ]
    },
    "appl-line": {
      "patterns": [
        {
          "match": "^\\s*([A-Z][A-Z0-9_ ]*?)\\s*(:|=)\\s*(.*?)\\s*(;)?\\s*$",
          "captures": {
            "1": {
              "name": "variable.other.appl.tp"
            },
            "2": {
              "name": "keyword.operator.assignment.tp"
            },
            "3": {
              "patterns": [
                {
                  "include": "#attr-value"
                }
              ]
            },
            "4": {
              "name": "punctuation.terminator.tp"
            }
          }
        },
        {
          "match": "^\\s*([A-Z][A-Z0-9_]*)\\s*;?\\s*$",
          "captures": {
            "1": {
              "name": "keyword.other.appl-header.tp"
            }
          }
        }
      ]
    },
    "pos-block": {
      "begin": "^(P)(\\[)(\\d+)(:\"[^\"]*\")?(\\])\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "support.type.position.tp"
        },
        "2": {
          "name": "punctuation.bracket.tp"
        },
        "3": {
          "name": "entity.name.tag.position-index.tp"
        },
        "4": {
          "name": "string.quoted.double.position-comment.tp"
        },
        "5": {
          "name": "punctuation.bracket.tp"
        },
        "6": {
          "name": "punctuation.brace.tp"
        }
      },
      "end": "^(\\})\\s*(;)",
      "endCaptures": {
        "1": {
          "name": "punctuation.brace.tp"
        },
        "2": {
          "name": "punctuation.terminator.tp"
        }
      },
      "patterns": [
        {
          "match": "^\\s*(GP\\d+)(:)",
          "captures": {
            "1": {
              "name": "entity.name.tag.group.tp"
            },
            "2": {
              "name": "punctuation.separator.tp"
            }
          }
        },
        {
          "match": "\\b(UF|UT)\\s*(:)\\s*(F)\\b",
          "captures": {
            "1": {
              "name": "variable.other.pos-field.tp"
            },
            "2": {
              "name": "punctuation.separator.tp"
            },
            "3": {
              "name": "invalid.deprecated.untaught.tp"
            }
          }
        },
        {
          "match": "\\b(UF|UT)\\s*(:)\\s*(\\d+)",
          "captures": {
            "1": {
              "name": "variable.other.pos-field.tp"
            },
            "2": {
              "name": "punctuation.separator.tp"
            },
            "3": {
              "name": "constant.numeric.tp"
            }
          }
        },
        {
          "match": "\\b(CONFIG)\\s*(:)\\s*('[^']*')",
          "captures": {
            "1": {
              "name": "variable.other.pos-field.tp"
            },
            "2": {
              "name": "punctuation.separator.tp"
            },
            "3": {
              "name": "string.quoted.single.config.tp"
            }
          }
        },
        {
          "match": "\\b(X|Y|Z|W|P|R|E\\d|J\\d+)\\s*(=)\\s*(\\*{3,})",
          "captures": {
            "1": {
              "name": "variable.other.pos-field.tp"
            },
            "2": {
              "name": "keyword.operator.assignment.tp"
            },
            "3": {
              "name": "invalid.deprecated.untaught.tp"
            }
          }
        },
        {
          "match": "\\b(X|Y|Z|W|P|R|E\\d|J\\d+)\\s*(=)\\s*(-?[0-9]*\\.?[0-9]+)\\s*(mm|deg|inch)?",
          "captures": {
            "1": {
              "name": "variable.other.pos-field.tp"
            },
            "2": {
              "name": "keyword.operator.assignment.tp"
            },
            "3": {
              "name": "constant.numeric.tp"
            },
            "4": {
              "name": "keyword.other.unit.tp"
            }
          }
        },
        {
          "match": ",",
          "name": "punctuation.separator.tp"
        }
      ]
    },
    "instruction-line": {
      "begin": "^(\\s*)(\\d+)(:)",
      "beginCaptures": {
        "2": {
          "name": "constant.numeric.line-number.tp"
        },
        "3": {
          "name": "punctuation.separator.line-number.tp"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#remark"
        },
        {
          "include": "#motion-start"
        },
        {
          "include": "#instruction-body"
        }
      ]
    },
    "comment-line": {
      "comment": "A TP remark: '!' followed by text, optionally ';'-terminated. Matched only when the '!' opens the instruction body (a real comment line); a '!' inside an expression is the logical NOT operator and is matched by #operator.",
      "patterns": [
        {
          "match": "^(\\s*)(\\d+)(:)(\\s*)(!.*?)(\\s*;)?\\s*$",
          "captures": {
            "2": {
              "name": "constant.numeric.line-number.tp"
            },
            "3": {
              "name": "punctuation.separator.line-number.tp"
            },
            "5": {
              "name": "comment.line.exclamation.tp"
            },
            "6": {
              "name": "punctuation.terminator.tp"
            }
          }
        },
        {
          "match": "^(\\s*)(:)(\\s*)(!.*?)(\\s*;)?\\s*$",
          "captures": {
            "2": {
              "name": "punctuation.separator.continuation.tp"
            },
            "4": {
              "name": "comment.line.exclamation.tp"
            },
            "5": {
              "name": "punctuation.terminator.tp"
            }
          }
        }
      ]
    },
    "remark": {
      "match": "//.*$",
      "name": "comment.line.double-slash.remark.tp"
    },
    "motion-start": {
      "match": "\\G(J|L|C|A|S)(?=\\s)",
      "captures": {
        "1": {
          "name": "keyword.control.motion.tp"
        }
      }
    },
    "instruction-body": {
      "patterns": [
        {
          "include": "#string"
        },
        {
          "include": "#label-def-or-ref"
        },
        {
          "include": "#call"
        },
        {
          "include": "#vision"
        },
        {
          "include": "#speed"
        },
        { "include": "#catalog" }, {
          "include": "#motion-option"
        },
        {
          "include": "#register"
        },
        {
          "include": "#io"
        },
        {
          "include": "#sysvar"
        },
        {
          "include": "#keyword"
        },
        {
          "include": "#operator"
        },
        {
          "include": "#number"
        },
        {
          "include": "#terminator"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "match": "'[^']*'",
          "name": "string.quoted.single.tp"
        },
        {
          "match": "\"[^\"]*\"",
          "name": "string.quoted.double.tp"
        }
      ]
    },
    "label-def-or-ref": {
      "patterns": [
        {
          "match": "\\b(JMP)\\s+(LBL)(\\[)(\\d+|R\\[\\d+(?::[^\\]]*)?\\])(?::([^\\]]*))?(\\])",
          "captures": {
            "1": {
              "name": "keyword.control.jump.tp"
            },
            "2": {
              "name": "support.type.label.tp"
            },
            "3": {
              "name": "punctuation.bracket.tp"
            },
            "4": {
              "name": "variable.other.label.reference.tp"
            },
            "5": {
              "name": "variable.other.tp-label.tp"
            },
            "6": {
              "name": "punctuation.bracket.tp"
            }
          }
        },
        {
          "match": "\\G\\s*(LBL)(\\[)(\\d+)(?::([^\\]]*))?(\\])",
          "captures": {
            "1": {
              "name": "support.type.label.tp"
            },
            "2": {
              "name": "punctuation.bracket.tp"
            },
            "3": {
              "name": "entity.name.label.definition.tp"
            },
            "4": {
              "name": "variable.other.tp-label.tp"
            },
            "5": {
              "name": "punctuation.bracket.tp"
            }
          }
        },
        {
          "match": "\\b(LBL)(\\[)(\\d+|R\\[\\d+(?::[^\\]]*)?\\])(?::([^\\]]*))?(\\])",
          "captures": {
            "1": {
              "name": "support.type.label.tp"
            },
            "2": {
              "name": "punctuation.bracket.tp"
            },
            "3": {
              "name": "variable.other.label.reference.tp"
            },
            "4": {
              "name": "variable.other.tp-label.tp"
            },
            "5": {
              "name": "punctuation.bracket.tp"
            }
          }
        }
      ]
    },
    "call": {
      "match": "\\b(CALL|RUN)\\s+([A-Za-z0-9_\\-]+)",
      "captures": {
        "1": {
          "name": "keyword.control.call.tp"
        },
        "2": {
          "name": "entity.name.function.call.tp"
        }
      }
    },
    "vision": {
      "match": "\\b(VISION)\\s+(RUN_FIND|GET_OFFSET|GET_NFOUND|GET_PASSFAIL|CAMERA_CALIB|SET_REFERENCE|OVERRIDE|GET_READING|CAMERA_VIEW|GET_QUEUE|CLEAR_QUEUE|RUN_FIND_ANY|ARRAY_PROC|COUNT_PROC|SET_PROC_PARAM|GET_PROC_PARAM)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.vision.tp"
        },
        "2": {
          "name": "support.function.vision.tp"
        }
      }
    },
    "speed": {
      "match": "\\b(\\d+(?:\\.\\d+)?|R\\[\\d+(?::[^\\]]*)?\\]|AR\\[\\d+\\])(mm/sec|cm/min|inch/min|deg/sec|%|sec|msec)",
      "captures": {
        "1": {
          "name": "constant.numeric.speed.tp"
        },
        "2": {
          "name": "keyword.other.unit.speed.tp"
        }
      }
    },
    "motion-option": {
      "patterns": [
        {
          "match": "\\b(FINE|CNT\\d{1,3}|CNT|CD\\d{1,3}|CR\\d{1,3})\\b",
          "name": "storage.modifier.termination.tp"
        },
        {
          "match": "\\b(ACC\\d{1,3}|ACC)\\b",
          "name": "storage.modifier.motion-option.tp"
        },
        {
          "match": "\\b(Offset|Tool_Offset|VOFFSET|Skip|SkipJump|TB|TA|DB|INC|RTCP|PTH|Wjnt|COORD|BREAK|EV\\d*%?|Ind\\.EV\\d*%?|PSPD\\d*|MROT|CTV\\d*|FPLIN|AP_LD\\d*|RT_LD\\d*|Weave|Weave End|TIME BEFORE|TIME AFTER|DISTANCE BEFORE|POINT_LOGIC|Arc Start|Arc End|SPOT|BSPOT|Search|SEARCH|Track|TRACK|MINROT|LINEAR_MAX_SPEED|ORNT_BASE|LDR|Continuous Rotation|CTR|Approach|Depart|CFOFFSET|GP\\d+|LBL)\\b",
          "name": "storage.modifier.motion-option.tp"
        }
      ]
    },
    "register": {
      "comment": "Registers, position registers, string registers, argument registers, positions, timers, alarms.",
      "begin": "\\b(R|PR|SR|AR|VR|P|GP|TIMER|UALM|DR|TIMER_OVERFLOW|ERR_NUM|UFRAME|UTOOL|PL|GO|GI|SP|CA|IR|POSREG)(\\[)",
      "beginCaptures": {
        "1": {
          "name": "support.type.register.tp"
        },
        "2": {
          "name": "punctuation.bracket.tp"
        }
      },
      "end": "(\\])",
      "endCaptures": {
        "1": {
          "name": "punctuation.bracket.tp"
        }
      },
      "patterns": [
        {
          "comment": "index[,element][:state][:comment]; a multi-group register carries a group prefix first: PR[GP2:5], PR[GP1:5,3]",
          "match": "\\G(?:(GP)(\\d+)(:))?(\\d+)(?:(,)(\\d+))?(?:(:)\\s*(ON|OFF|\\*|-?\\d+)\\s*(?=:))?(?::([^\\]]*))?",
          "captures": {
            "1": {
              "name": "support.type.register.tp"
            },
            "2": {
              "name": "constant.numeric.index.tp"
            },
            "3": {
              "name": "punctuation.separator.tp"
            },
            "4": {
              "name": "constant.numeric.index.tp"
            },
            "5": {
              "name": "punctuation.separator.tp"
            },
            "6": {
              "name": "constant.numeric.index.tp"
            },
            "7": {
              "name": "punctuation.separator.tp"
            },
            "8": {
              "name": "constant.language.io-state.tp"
            },
            "9": {
              "name": "variable.other.tp-label.tp"
            }
          }
        },
        {
          "match": "\\G(\\*)",
          "name": "constant.language.wildcard.tp"
        },
        {
          "include": "#register"
        },
        {
          "include": "#io"
        },
        {
          "match": "\\bAR\\[\\d+\\]",
          "name": "support.type.register.tp"
        },
        {
          "match": ",",
          "name": "punctuation.separator.tp"
        },
        {
          "match": ":([^\\]]*)",
          "name": "variable.other.tp-label.tp"
        }
      ]
    },
    "io": {
      "begin": "\\b(DI|DO|RI|RO|GI|GO|AI|AO|UI|UO|SI|SO|F|M|WI|WO|WSI|WSO|SPI|SPO|SDI|SDO|LDI|LDO|TPIN|TPOUT|PLCIN|PLCOUT)(\\[)",
      "beginCaptures": {
        "1": {
          "name": "support.type.io.tp"
        },
        "2": {
          "name": "punctuation.bracket.tp"
        }
      },
      "end": "(\\])",
      "endCaptures": {
        "1": {
          "name": "punctuation.bracket.tp"
        }
      },
      "patterns": [
        {
          "match": "\\G(\\d+)(?:(:)\\s*(ON|OFF|\\*|-?\\d+)\\s*(?=:))?(?::([^\\]]*))?",
          "captures": {
            "1": {
              "name": "constant.numeric.index.tp"
            },
            "2": {
              "name": "punctuation.separator.tp"
            },
            "3": {
              "name": "constant.language.io-state.tp"
            },
            "4": {
              "name": "variable.other.tp-label.tp"
            }
          }
        },
        {
          "include": "#register"
        },
        {
          "match": ":([^\\]]*)",
          "name": "variable.other.tp-label.tp"
        }
      ]
    },
    "sysvar": {
      "match": "\\$[A-Za-z_][A-Za-z0-9_$.]*(?:\\[[0-9,]+\\](?:\\.[A-Za-z_$][A-Za-z0-9_$]*)*)*",
      "name": "variable.language.system.tp"
    },
    "catalog": {"comment":"GENERATED by scripts/build-tp-syntax.mjs from data/tp-syntax.json (FANUC manuals): option instructions, motion options and macros","patterns":[{"match":"(?<![A-Za-z0-9_])(Pressure\\s+standard\\s+gun|TOOL_OFFSET\\s+CONDITION|VISION\\s+SET_REFERENCE|Adjust\\s+Start\\s+Height|Request\\s+to\\s+Continue|SENSOR\\s+Offset\\s+START|SENSOR\\s+OFFSET\\s+START|SENSOR\\s+SEARCH\\s+POINT|SENSOR\\s+SEARCH\\s+START|VISION\\s+CAMERA_CALIB|VISION\\s+GET_PASSFAIL|GET\\s+DIAGNOSIS\\s+DATA|VISION\\s+GET_READING|Dispense\\s+Complete|RESET\\s+WATER\\s+SAVER|SENSOR\\s+DISCONNECT|SENSOR\\s+Offset\\s+END|SENSOR\\s+OFFSET\\s+END|SENSOR\\s+SEARCH\\s+END|TC_ONLINE\\s+DISABLE|VISION\\s+GET_NFOUND|VISION\\s+GET_OFFSET|VOFFSET\\s+CONDITION|Change\\s+Direction|Clear\\s+to\\s+Proceed|COL\\s+GUARD\\s+ADJUST|OFFSET\\s+CONDITION|open\\s+clamp\\s+early|Relieve\\s+Pressure|reposition\\s+clamp|Request\\s+continue|SENSOR\\s+DIAGNOSIS|Set\\s+CurrentValve|TC_ONLINE\\s+ENABLE|TorchMate\\s+Adjust|Touch\\s+Offset\\s+End|TOUCH\\s+OFFSET\\s+END|Turn\\s+OFF\\s+Blowoff|verify\\s+decn\\s+code|Clear\\s+User\\s+Page|clr\\s+of\\s+transfer|GET\\s+PART\\s+DETECT|Gun\\s+Zero\\s+Master|Meter\\s+Sleep\\s+All|Prepare\\s+to\\s+Pick|Rec\\s+Path\\s+Resume|Reposition\\s+Near|Turn\\s+OFF\\s+Vacuum|VISION\\s+OVERRIDE|VISION\\s+RUN_FIND|move\\s+to\\s+repair|Op\\.\\s+Entry\\s+Menu|Prompt\\s+Box\\s+Msg|Rec\\s+Path\\s+Pause|Rec\\s+Path\\s+Start|SENSOR\\s+CONNECT|SET\\s+ISDT\\s+SPEED|SKIP\\s+CONDITION|Turn\\s+ON\\s+Vacuum|Begin\\s+Process|Check\\s+No\\s+Part|END\\s+CONDITION|GUN\\s+CONTACTOR|IC\\s+Hand\\s+Model|ISO\\s+CONTACTOR|MP\\s+Offset\\s+End|MP\\s+OFFSET\\s+END|Prompt\\s+Box\\s+YN|RESET\\s+STEPPER|SERVOTOOL\\s+END|Set\\s+Direction|SOFTFLOAT\\s+END|STOP\\s+ALL\\s+ISDT|IC\\s+Comb\\s+Pair|Meter\\s+Bypass|Move\\s+to\\s+home|Part\\s+Present|Rec\\s+Path\\s+End|Release\\s+Part|Reload\\s+Meter|Remote\\s+Start|Request\\s+Menu|RESET\\s+WELDER|Sample\\s+Start|Search\\s+Start|SEARCH\\s+START|STICK\\s+DETECT|TMate\\s+Adjust|TORQUE\\s+ERROR|Touch\\s+Offset|TOUCH\\s+OFFSET|Track\\s+SENSOR|TRACK\\s+SENSOR|Weave\\s+Circle|Weave\\s+Figure|ADJST\\s+SERVO|AUTO\\s+TUNING|Do\\s+Bwd\\s+Exit|EASY\\s+NORMAL|Meter\\s+Sleep|MONITOR\\s+END|Send\\s+SysVar|Set\\s+MH\\s+Tool|Set\\s+segment|Status\\s+Menu|TOOL\\s+ATTACH|TOOL\\s+DETACH|UNLOCK\\s+PREG|UNLOCK\\s+VREG|Weave\\s+Cust1|Weave\\s+Cust2|Weave\\s+Cust3|CLOSE\\s+HAND|COL\\s+DETECT|ENTER\\s+ZONE|FORCE\\s+CTRL|GUN\\s+ATTACH|GUN\\s+DETACH|Hand\\s+close|IBGN\\s+start|RELAX\\s+HAND|Sample\\s+End|Search\\s+End|SEARCH\\s+END|Send\\s+Event|STITCH\\s+END|Track\\s+TAST|Weave\\s+Sine|Weld\\s+Start|Arc\\s+Start|at\\s+pounce|EXIT\\s+ZONE|FOLLOW\\s+UP|Grip\\s+Part|Hand\\s+open|List\\s+Menu|LOCK\\s+PREG|LOCK\\s+VREG|MP\\s+Offset|MP\\s+OFFSET|OPEN\\s+HAND|SAFE\\s+ZONE|Send\\s+Data|Track\\s+AVC|Track\\s+End|TRACK\\s+END|Weave\\s+End|Get\\s+Data|IBGN\\s+end|Weld\\s+End|Arc\\s+End)(?![A-Za-z0-9_])","name":"keyword.control.option.tp"},{"match":"\\b(LINEAR_MAX_SPEED|JOINT_MAX_SPEED|TIMER_OVERFLOW|Approach_RATE|Approach_STOP|Approach_WAIT|Detect_Circle|POWER_CONTROL|Detect_Joint|Detect_Point|DIAG_REC_SEC|UFrame_Start|WIRE_CONTROL|Calib_Start|CAMERA_VIEW|RESUME_PROG|UTool_Start|MAINT_PROG|Press_motn|PRESS_MOTN|SYNC_SCHED|Calib_End|CONTACTOR|EnterZone|FOUND_POS|GONE_TIME|LINECOUNT|SERVOTOOL|SLOPEDOWN|SOFTFLOAT|UTool_End|DIAG_REC|ErrorLBL|ExitZone|LINERATE|LINESTOP|Pressure|SyncZone|TIPDRESS|WaitZone|LINESIM|MESSAGE|PAYLOAD|PR_STRT|PR_SYNC|SLOPEUP|STEPPER|TCP_SPD|BACKUP|PR_END|PRE_LS|Search|SEARCH|STITCH|UFRAME|WELDER|BOUND|COORD|INPOS|LNSCH|PULSE|SAVER|Start|TIMER|UTOOL|Weave|LINE|SPOT|TRIG|UALM|End|MES|PPS|RPM|RSR|LE|LP|LS|PL|SS|WV)(?=\\s*\\[)","name":"keyword.control.option.tp"},{"match":"\\b(FINDSTR|STRLEN|SUBSTR|ATAN2|ROUND|TRUNC|ACOS|ASIN|ATAN|SQRT|ABS|COS|EXP|SIN|TAN|LN)(?=\\s*\\[)","name":"support.function.tp"},{"match":"\\b(CLEAR_RESUME_PROG|SpotProgTouch_Dsb|LINEAR_MAX_SPEED|MINUTE_OUTPUT_RQ|RETURN_PATH_DSBL|STOP_TRACKING|Update_Frame|Calibration|PALLETI