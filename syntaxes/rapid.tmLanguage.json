{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ABB RAPID",
  "scopeName": "source.rapid",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#header"
    },
    {
      "include": "#string"
    },
    {
      "include": "#module"
    },
    {
      "include": "#routine"
    },
    {
      "include": "#record"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#placeholder"
    },
    {
      "include": "#late-binding"
    },
    {
      "include": "#optional-argument"
    },
    {
      "include": "#control"
    },
    {
      "include": "#storage"
    },
    {
      "include": "#constant"
    },
    {
      "include": "#type"
    },
    {
      "include": "#instruction"
    },
    {
      "include": "#function"
    },
    {
      "include": "#label"
    },
    {
      "include": "#number"
    },
    {
      "include": "#operator"
    }
  ],
  "repository": {
    "comment": {
      "match": "!.*$",
      "name": "comment.line.exclamation.rapid"
    },
    "header": {
      "comment": "%%% VERSION:1 LANGUAGE:ENGLISH %%% at the top of exported modules",
      "match": "^\\s*(%%%)\\s*$|^\\s*(VERSION|LANGUAGE)\\s*(:)\\s*(\\S+)",
      "captures": {
        "1": {
          "name": "punctuation.definition.header.rapid"
        },
        "2": {
          "name": "keyword.other.header.rapid"
        },
        "3": {
          "name": "punctuation.separator.rapid"
        },
        "4": {
          "name": "constant.other.header.rapid"
        }
      }
    },
    "string": {
      "begin": "\"",
      "end": "\"(?!\")|$",
      "name": "string.quoted.double.rapid",
      "patterns": [
        {
          "match": "\"\"",
          "name": "constant.character.escape.rapid"
        },
        {
          "match": "\\\\(\\\\|[0-9A-Fa-f]{2})",
          "name": "constant.character.escape.rapid"
        }
      ]
    },
    "module": {
      "match": "(?i)^\\s*(MODULE)\\s+([A-Za-z]\\w*)\\s*(?:\\(([^)]*)\\))?",
      "captures": {
        "1": {
          "name": "keyword.other.module.rapid"
        },
        "2": {
          "name": "entity.name.type.module.rapid"
        },
        "3": {
          "patterns": [
            {
              "match": "(?i)\\b(SYSMODULE|NOSTEPIN|VIEWONLY|READONLY|NOVIEW)\\b",
              "name": "storage.modifier.module-attribute.rapid"
            }
          ]
        }
      }
    },
    "routine": {
      "patterns": [
        {
          "match": "(?i)^\\s*(?:(LOCAL)\\s+)?(PROC|TRAP)\\s+([A-Za-z]\\w*)",
          "captures": {
            "1": {
              "name": "storage.modifier.rapid"
            },
            "2": {
              "name": "keyword.other.routine.rapid"
            },
            "3": {
              "name": "entity.name.function.rapid"
            }
          }
        },
        {
          "match": "(?i)^\\s*(?:(LOCAL)\\s+)?(FUNC)\\s+([A-Za-z]\\w*)\\s+([A-Za-z]\\w*)",
          "captures": {
            "1": {
              "name": "storage.modifier.rapid"
            },
            "2": {
              "name": "keyword.other.routine.rapid"
            },
            "3": {
              "name": "support.type.rapid"
            },
            "4": {
              "name": "entity.name.function.rapid"
            }
          }
        },
        {
          "match": "(?i)\\b(ENDPROC|ENDFUNC|ENDTRAP|ENDMODULE|ENDRECORD)\\b",
          "name": "keyword.other.routine.rapid"
        },
        {
          "match": "(?i)^\\s*(ERROR|UNDO|BACKWARD)\\b",
          "name": "keyword.control.handler.rapid"
        }
      ]
    },
    "record": {
      "match": "(?i)^\\s*(?:(LOCAL)\\s+)?(RECORD)\\s+([A-Za-z]\\w*)",
      "captures": {
        "1": {
          "name": "storage.modifier.rapid"
        },
        "2": {
          "name": "keyword.other.record.rapid"
        },
        "3": {
          "name": "entity.name.type.record.rapid"
        }
      }
    },
    "declaration": {
      "comment": "VAR num x / PERS robtarget p10 / CONST speeddata vFast / routine parameters",
      "match": "(?i)\\b(?:(LOCAL|TASK)\\s+)?(VAR|PERS|CONST|INOUT)\\s+([A-Za-z]\\w*)\\s+([A-Za-z]\\w*)",
      "captures": {
        "1": {
          "name": "storage.modifier.rapid"
        },
        "2": {
          "name": "storage.type.rapid"
        },
        "3": {
          "name": "support.type.rapid"
        },
        "4": {
          "name": "variable.other.declaration.rapid"
        }
      }
    },
    "placeholder": {
      "match": "<(SMT|EXP|ARG|VAR|ID|DDN|RDN|PAR|TDN|CSE|ANY|DIM|TYPE)>",
      "name": "invalid.placeholder.rapid"
    },
    "late-binding": {
      "match": "%",
      "name": "keyword.operator.late-binding.rapid"
    },
    "optional-argument": {
      "comment": "\\WObj:=wobj1, \\TLoad?tl, \\Conc - and \\switch in parameter lists",
      "match": "(\\\\)([A-Za-z]\\w*)",
      "captures": {
        "1": {
          "name": "punctuation.definition.parameter.rapid"
        },
        "2": {
          "name": "variable.parameter.optional.rapid"
        }
      }
    },
    "control": {
      "match": "(?i)\\b(IF|THEN|ELSEIF|ELSE|ENDIF|FOR|FROM|TO|STEP|DO|ENDFOR|WHILE|ENDWHILE|TEST|CASE|DEFAULT|ENDTEST|GOTO|RETURN|RAISE|RETRY|TRYNEXT|EXIT|CONNECT|WITH|BREAK|CONTINUE)\\b",
      "name": "keyword.control.rapid"
    },
    "storage": {
      "match": "(?i)\\b(VAR|PERS|CONST|LOCAL|TASK|INOUT|ALIAS)\\b",
      "name": "storage.type.rapid"
    },
    "constant": {
      "patterns": [
        {
          "match": "(?i)\\b(TRUE|FALSE)\\b",
          "name": "constant.language.boolean.rapid"
        },
        {
          "match": "(?i)\\b(fine|z\\d+|v\\d+|vmax|tool0|wobj0|load0)\\b",
          "name": "constant.language.predefined.rapid"
        },
        {
          "match": "\\b(ERR_[A-Z0-9_]+|ERRNO|OP_AUTO|OP_MAN_PROG|OP_MAN_TEST)\\b",
          "name": "constant.other.rapid"
        }
      ]
    },
    "type": {
      "match": "(?i)\\b(capaptrreferencedata|EGM_MAX_RAPID_DNUM|fcspdchgtunetype|ionetwork_state|translationdata|caplatrackdata|css_offset_dir|iodevice_state|restartblkdata|supervtimeouts|weavestartdata|fccylindervol|fcforcevector|fcprocessdata|fcspeedvector|paridvalidnum|sensorvardata|stoppointdata|camerastatus|cameratarget|capspeeddata|captrackdata|capweavedata|css_soft_dir|egmframetype|fccondstatus|flypointdata|handler_type|iounit_state|processtimes|signalorigin|socketstatus|triggiosdnum|uidisplaynum|wzstationary|capstopmode|egmstopmode|fcspherevol|jointtarget|loadsession|restartdata|sensorstate|wztemporary|buttondata|egm_minmax|event_type|exec_level|motsetdata|rmqmessage|testsignal|triggstrgo|tsp_status|cameradev|cfgdomain|corrdescr|errdomain|fcdamping|forcedata|loadidnum|pathrecid|rmqheader|robtarget|shapedata|socketdev|speeddata|stringdig|syncident|triggdata|triggmode|uishownum|aiotrigg|busstate|confdata|cssframe|egmident|egmstate|execmode|extjoint|fcboxvol|fclindir|fcrotdir|fcxyznum|icondata|listitem|loaddata|paridnum|progdisp|rawbytes|robjoint|signalai|signalao|signaldi|signaldo|signalgi|signalgo|signalxx|spotdata|tooldata|trapdata|triggios|tunetype|wobjdata|zonedata|capdata|datapos|errtype|fcframe|fcplane|identno|mecunit|pnpdata|rmqslot|simdata|btnres|dionum|errnum|errstr|gunnum|intnum|opcalc|orient|sensor|string|switch|symnum|taskid|clock|iodev|opnum|tasks|tpnum|bool|byte|dnum|pose|dir|num|pos)\\b",
      "name": "support.type.rapid"
    },
    "instruction": {
      "match": "(?i)^\\s*(SafetyControllerSyncRequest|FCResetMaxForceChangeTune|FCSetMaxForceChangeTune|PrxActivAndStoreRecord|PrxSetRecordSampleTime|CamStartSetParameter|CapRemoveSupervision|MotionProcessModeSet|CamWaitSetParameter|CapSetupSupervision|CSSForceOffsetDeact|FCResetLPFilterTune|FricIdSetFricLevels|RemoveAllCyclicBool|CapInitSupervision|FCResetDampingTune|GetGroupSignalInfo|SpeedLimCheckPoint|CamSetProgramMode|CornerPathWarning|CSSForceOffsetAct|FCRefSprForceCart|FCSetLPFilterTune|PrxDbgStoreRecord|ResetAxisDistance|ResetAxisMoveTime|ResetTorqueMargin|SafetyControlSync|SocketReceiveFrom|CalcRotAxisFrame|CapAPTrSetupPERS|DeactEventBuffer|FCCondReoriSpeed|FCSetDampingTune|FCSpdChgTunReset|FCSupvReoriSpeed|HollowWristReset|PrxUseFileRecord|RemoveCyclicBool|SupSyncSensorOff|SystemStopAction|CamGetParameter|CamSetParameter|CamStartLoadJob|FCCondWaitWhile|MatrixTranspose|PathLengthReset|PathLengthStart|ProcerrRecovery|PrxResetRecords|PrxSetPosOffset|PrxSetSyncalarm|ResetRetryCount|RMQGetMsgHeader|SetupCyclicBool|SupSyncSensorOn|SyncMoveSuspend|UIMsgWriteAbort|ActEventBuffer|CamSetExposure|CamWaitLoadJob|CapAPTrSetupAI|CapAPTrSetupAO|CapSetDOAtStop|CAPSetStopMode|EGMStreamStart|FCCondTCPSpeed|FCPress1LStart|FCRefMoveFrame|FCSpdChgTunSet|FCSupvTCPSpeed|FricIdEvaluate|IOEventMessage|PathLengthStop|PathRecMoveBwd|PathRecMoveFwd|PrxActivRecord|PrxDeactRecord|PrxStartRecord|PrxStoreRecord|RMQSendMessage|SetLeadThrough|StartMoveRetry|SyncMoveResume|TestSignDefine|TextTabInstall|TriggDataReset|UnpackRawBytes|WaitTestAndSet|WZHomeJointDef|CamSetRunMode|ClearRawBytes|CSSDeactMoveL|CSSOffsetTune|EGMSetupLTAPP|EGMStreamStop|FCCondCombine|FCSpdChgDeact|ManLoadIdProc|MatrixInverse|MatrixSolveQR|MToolRotCalib|MToolTCPCalib|PrxStopRecord|RMQEmptyQueue|RMQGetMessage|RMQGetMsgData|SetAllDataVal|SetDataSearch|SocketConnect|SocketReceive|STIndGunReset|SToolRotCalib|SToolTCPCalib|StopMoveReset|TestSignReset|TriggDataCopy|TriggStopProc|WriteRawBytes|WZLimJointDef|AliasIOReset|CamGetResult|CapAPTrSetup|CapCondSetDO|CapLATrSetup|CapNoProcess|CapWeaveSync|CheckProgRef|CopyRawBytes|FCCondOrient|FCCondTorque|FCSupvOrient|FCSupvTorque|GetJointData|IODeactivate|IODeviceMute|MechUnitLoad|PackDNHeader|PackRawBytes|PathRecStart|ReadRawBytes|RemoveSuperv|ResetPPMoved|SimCollision|SocketAccept|SocketCreate|SocketListen|SocketSendTo|SpeedLimAxis|SpeedRefresh|SyncMoveUndo|SyncToSensor|TriggCheckIO|WaitSyncTask|WriteCfgData|AliasCamera|CamReqImage|CapEquiDist|CirPathMode|ClearIOBuff|EGMActJoint|EGMRunJoint|EGMWaitCond|EraseModule|FCCondForce|FCRefCircle|FCRefSpiral|FCRefTorque|FCSpdChgAct|FCSupvForce|GetTrapData|ICapPathPos|IRMQMessage|JSONFromVal|MatrixReset|MatrixSolve|PathRecStop|PrxResetPos|RaiseToUser|ReadCfgData|ReadErrData|RMQFindSlot|RMQReadWait|RMQSendWait|SaveCfgData|SetupSuperv|SiGetCyclic|SiSetCyclic|SocketClose|STCalcForce|StepBwdPath|STTuneReset|SyncMoveOff|TriggRampAO|WorldAccLim|WriteAnyBin|WriteStrBin|WriteVarArr|BytesReset|CamLoadJob|CancelLoad|CapRefresh|CollDetect|CorrDiscon|DebugBreak|DropSensor|EGMActMove|EGMActPose|EGMRunPose|EGMSetupAI|EGMSetupAO|EGMSetupGI|EGMSetupUC|FCPressEnd|FCRefForce|FCRefStart|FricIdInit|GetDataVal|GetSysData|InitSuperv|IOActivate|IOBusStart|IOBusState|MatrixMult|PathAccLim|ReadAnyBin|ReadVarArr|RemoveFile|RenameFile|SearchExtJ|SetDataVal|SetSysData|SocketBind|SocketSend|SyncMoveOn|TPReadDnum|TriggEquip|TriggSpeed|UIMsgWrite|WaitSensor|WriteBlock|BookErrNo|CallByVar|ClearPath|CorrClear|CorrWrite|DeactUnit|ExitCycle|FCCondPos|FCRefLine|FCRefStop|FCSupvPos|FitCircle|FitSphere|IODisable|ISignalAI|ISignalAO|ISignalDI|ISignalDO|ISignalGI|ISignalGO|IVarValue|JSONToVal|MatrixAdd|MatrixSub|MatrixSVD|MotionSup|MoveCSync|MoveJSync|MoveLSync|PathResol|ReadBlock|RemoveDir|ResetData|RestoPath|SenDevice|SiConnect|SoftDeact|SoftElbow|StartLoad|StartMove|StorePath|TPReadNum|TriggAbsJ|TriggJIOs|TriggLIOs|TuneReset|TuneServo|UIDisplay|WaitUntil|WarmStart|WZDisable|BitClear|CamFlush|ClkReset|ClkStart|CloseDir|ContactL|CopyFile|CSSDeact|DropWObj|EGMGetId|EGMMoveC|EGMMoveL|EGMReset|EOffsOff|EOffsSet|ErrRaise|ErrWrite|FCPressC|FCPressL|FCRefRot|FitPlane|GripLoad|IDisable|IndAMove|IndCMove|IndDMove|IndReset|IndRMove|InvertDO|IOEnable|IPathPos|MoveAbsJ|MoveAbsL|MoveExtJ|PDispOff|PDispSet|ProcCall|SetForce|SingArea|SkipWarn|SpyStart|STIndGun|StopMove|TPReadFK|TriggInt|UIMsgBox|WaitLoad|WaitTime|WaitWObj|WristOpt|WriteBin|WriteVar|WZBoxDef|WZCylDef|WZEnable|WZLimSup|WZSphDef|ActUnit|AliasIO|ClkStop|Comment|CorrCon|EGMStop|EOffsOn|FCCalib|FCDeact|FitLine|IDelete|IEnable|MakeDir|MoveCAO|MoveCDO|MoveCGO|MoveJAO|MoveJDO|MoveJGO|MoveLAO|MoveLDO|MoveLGO|MovePnP|OpenDir|PDispOn|PulseDO|SCWrite|SearchC|SearchJ|SearchL|SiClose|SoftAct|SpyStop|STCalib|STClose|TPErase|TPWrite|TriggIO|WaitRob|WZDOSet|AccSet|BitSet|CalibJ|CalibL|CSSAct|ErrLog|IError|ISleep|ITimer|IWatch|LoadId|Rewind|SpotML|STOpen|STTune|TPShow|TriggC|TriggJ|TriggL|TryInt|UIShow|UnLoad|VelSet|WaitAI|WaitAO|WaitDI|WaitDO|WaitGI|WaitGO|WZFree|Clear|Close|ConfJ|ConfL|FCAct|IPers|Label|MoveC|MoveJ|MoveL|Reset|SetAO|SetDO|SetGO|SpotJ|SpotL|Write|CapC|CapL|Decr|ICap|Incr|Load|Open|Save|Stop|Add|Set)\\b",
      "captures": {
        "1": {
          "name": "support.function.instruction.rapid"
        }
      }
    },
    "function": {
      "match": "(?i)\\b(SafetyControllerGetGroupChecksum|SafetyControllerGetNextGroupName|SafetyControllerGetOpModePinCode|SafetyControllerGetUserChecksum|SafetyControllerGetSWVersion|SafetyControllerGetChecksum|GetMaxNumberOfCyclicBool|GetNumberOfCyclicBool|GetModalPayloadMode|MaxExtReorientSpeed|MaxRobReorientSpeed|CamNumberOfResults|IsBrakeCheckActive|PrxGetMaxRecordpos|GetNextCyclicBool|MaxExtLinearSpeed|CalcRotAxisFrame|FCGetProcessData|IsMechUnitActive|IsStopStateEvent|PPMovedInManMode|RemainingRetries|TextTabFreeToUse|CalcRotAxFrameZ|CamGetLoadedJob|GetAxisDistance|GetAxisMoveTime|GetNextMechUnit|GetSignalOrigin|GetTorqueMargin|MotionPlannerNo|PathRecValidBwd|PathRecValidFwd|SocketGetStatus|TaskIsExecuting|CamGetExposure|CapGetFailSigs|CSpeedOverride|GetMecUnitName|GetMotorTorque|GetNextProduct|GetServiceInfo|GetUASUserName|IONetworkState|RMQGetSlotName|TriggDataValid|FCIsForceMode|GetNextOption|IODeviceState|IsLeadThrough|IsStopMoveAct|NonMotionMode|ParIdPosValid|ParIdRobValid|PathLengthGet|STIsServoTool|UIClientExist|BitCheckDnum|FileTimeDnum|GetTSPStatus|IsCyclicBool|IsSyncMoveOn|STCalcTorque|TaskIsActive|TestSignRead|UIAlphaEntry|UIMessageBox|DefAccFrame|EGMGetState|ExecHandler|GetTaskName|GOutputDnum|IOUnitState|MaxRobSpeed|ModTimeDnum|ProgMemFree|RawBytesLen|STCalcForce|TasksInSync|UIDnumEntry|BitAndDnum|BitLShDnum|BitNegDnum|BitRShDnum|BitXOrDnum|BytesToVal|CalcJointT|CamGetMode|CamGetName|FCGetForce|GetNextSym|GetSysInfo|GInputDnum|IsCollFree|ReadStrBin|SocketPeek|STIsClosed|STIsIndGun|StrDigCalc|TaskRunMec|TaskRunRob|TestAndSet|TextTabGet|UIDnumTune|UIListView|UINumEntry|ValToBytes|ATan2Dnum|BitOrDnum|ByteToStr|CrossProd|DefDFrame|DnumToNum|DnumToStr|EventType|ExecLevel|NumToDnum|OrientZYX|PathLevel|PFRestart|ReadMotor|RoundDnum|STIsCalib|StrDigCmp|StrFormat|StrToByte|TruncDnum|UINumTune|ACosDnum|ASinDnum|ATanDnum|BitCheck|CalcRobT|CorrRead|DecToHex|DefFrame|Distance|EulerZYX|FCLoadID|FileSize|FileTime|HexToDec|IndInpos|IndSpeed|IsCSSAct|ModExist|NumToStr|PoseMult|PoseVect|ReadDnum|SqrtDnum|STIsOpen|StrMatch|StrOrder|StrToVal|ValToStr|VectMagn|AbsDnum|AOutput|ArgName|CJointT|ClkRead|CosDnum|DotProd|DOutput|GetTime|GOutput|IsSysId|ModTime|NOrient|PoseInv|PowDnum|Present|ReadBin|ReadDir|ReadNum|ReadStr|ReadVar|RelTool|RobName|RunMode|SinDnum|StrFind|StrMemb|StrPart|StrSize|TanDnum|TextGet|ValidIO|AInput|BitAnd|BitLSh|BitNeg|BitRSh|BitXOr|Concat|DInput|FSSize|GInput|IsFile|IsPers|MirPos|OpMode|StrLen|StrMap|TestDI|ATan2|BitOr|CDate|CRobT|CTime|CTool|CWObj|IsVar|ORobT|RobOS|Round|Trunc|ACos|ASin|ATan|CPos|Offs|Rand|Sqrt|Type|Abs|Cos|Dim|Exp|Max|Min|Pow|Sin|Tan)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "support.function.builtin.rapid"
        }
      }
    },
    "label": {
      "match": "^\\s*([A-Za-z]\\w*)(:)(?!=)",
      "captures": {
        "1": {
          "name": "entity.name.label.rapid"
        },
        "2": {
          "name": "punctuation.separator.rapid"
        }
      }
    },
    "number": {
      "match": "(?i)(?<![\\w.])(0x[0-9a-f]+|0b[01]+|0o[0-7]+|(\\d+\\.?\\d*|\\.\\d+)(e[+-]?\\d+)?)\\b",
      "name": "constant.numeric.rapid"
    },
    "operator": {
      "patterns": [
        {
          "match": ":=",
          "name": "keyword.operator.assignment.rapid"
        },
        {
          "match": "<>|<=|>=|<|>|=",
          "name": "keyword.operator.comparison.rapid"
        },
        {
          "match": "(?i)\\b(AND|OR|XOR|NOT|DIV|MOD)\\b",
          "name": "keyword.operator.logical.rapid"
        },
        {
          "match": "[-+*/]",
          "name": "keyword.operator.arithmetic.rapid"
        }
      ]
    }
  }
}
