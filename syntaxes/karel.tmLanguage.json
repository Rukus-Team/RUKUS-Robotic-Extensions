{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FANUC KAREL",
  "scopeName": "source.fanuc.karel",
  "patterns": [
    { "include": "#comment" },
    { "include": "#directive" },
    { "include": "#string" },
    { "include": "#program" },
    { "include": "#routine" },
    { "include": "#declaration-section" },
    { "include": "#sysvar" },
    { "include": "#port" },
    { "include": "#type" },
    { "include": "#constant" },
    { "include": "#keyword" },
    { "include": "#builtin" },
    { "include": "#call" },
    { "include": "#number" },
    { "include": "#operator" },
    { "include": "#identifier" }
  ],
  "repository": {
    "comment": {
      "match": "--.*$",
      "name": "comment.line.double-dash.karel"
    },
    "directive": {
      "match": "^\\s*(%)(ALPHABETIZE|CMOSVARS|CMOS2SHADOW|COMMENT|CRTDEVICE|DEFGROUP|DELAY|ENVIRONMENT|INCLUDE|LOCKGROUP|NOABORT|NOBUSYLAMP|NOLOCKGROUP|NOPAUSE|NOPAUSESHFT|PRIORITY|SHADOWVARS|STACKSIZE|TIMESLICE|TPMOTION|UNINITVARS|INVISIBLE|IGNOREPAUSE)\\b(.*)$",
      "captures": {
        "1": { "name": "punctuation.definition.directive.karel" },
        "2": { "name": "keyword.control.directive.karel" },
        "3": { "patterns": [ { "include": "#comment" }, { "include": "#string" }, { "match": "[A-Za-z_][A-Za-z0-9_]*", "name": "entity.name.import.karel" }, { "include": "#number" }, { "include": "#operator" } ] }
      }
    },
    "string": {
      "match": "'([^']|'')*'",
      "name": "string.quoted.single.karel"
    },
    "program": {
      "match": "^\\s*(PROGRAM)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.program.karel" },
        "2": { "name": "entity.name.function.program.karel" }
      }
    },
    "routine": {
      "match": "\\b(ROUTINE)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.routine.karel" },
        "2": { "name": "entity.name.function.routine.karel" }
      }
    },
    "declaration-section": {
      "match": "^\\s*(VAR|CONST|TYPE|BEGIN|END)\\b",
      "captures": { "1": { "name": "keyword.control.section.karel" } }
    },
    "sysvar": {
      "match": "\\$[A-Za-z_][A-Za-z0-9_]*(?:\\[[^\\]]*\\])?(?:\\.\\$?[A-Za-z_][A-Za-z0-9_]*(?:\\[[^\\]]*\\])?)*",
      "name": "variable.language.system.karel"
    },
    "port": {
      "match": "\\b(DIN|DOUT|GIN|GOUT|AIN|AOUT|RDI|RDO|OPIN|OPOUT|TPIN|TPOUT|WDI|WDO|UIN|UOUT|FLG|MRK|LDI|LDO|SOPIN|SOPOUT|WSIN|WSOUT|PLCIN|PLCOUT|SDI|SDO)\\b(?=\\s*\\[)",
      "name": "support.type.port.karel"
    },
    "type": {
      "match": "\\b(INTEGER|REAL|BOOLEAN|STRING|BYTE|SHORT|ARRAY|POSITION|XYZWPR|XYZWPREXT|JOINTPOS|JOINTPOS1|JOINTPOS2|JOINTPOS3|JOINTPOS4|JOINTPOS5|JOINTPOS6|JOINTPOS7|JOINTPOS8|JOINTPOS9|VECTOR|PATH|FILE|CONFIG|STRUCTURE|ENDSTRUCTURE|CAM_SETUP|MODEL|VIS_PROCESS|QUEUE_TYPE|GROUP_ASSOC|PATHHEADER|NODEDATA|COMMON_ASSOC|SEMAPHORE|IN|CMOS|DRAM|OF|FROM|DISP_DAT_T|STD_PTH_NODE)\\b",
      "name": "storage.type.karel"
    },
    "constant": {
      "match": "\\b(TRUE|FALSE|ON|OFF|MAXINT|MININT|UNINIT|CR|TPDISPLAY|TPERROR|TPPROMPT|TPFUNC|TPSTATUS|CRTPROMPT|CRTERROR|CRTFUNC|CRTSTATUS|INPUT|OUTPUT|VISION|RSWORLD|AESWORLD|PI|EMPTY)\\b",
      "name": "constant.language.karel"
    },
    "keyword": {
      "match": "\\b(ABORT|ABOUT|AFTER|ALONG|ALSO|AND|AT|ATTACH|AWAY|AXIS|BEFORE|BY|BYNAME|CANCEL|CASE|CLOSE|CONDITION|CONNECT|CONTINUE|COORDINATED|DELAY|DISABLE|DISCONNECT|DIV|DO|DOWNTO|ELSE|ENABLE|END|ENDCONDITION|ENDFOR|ENDIF|ENDMOVE|ENDSELECT|ENDUSING|ENDWHILE|ERROR|EVAL|EVENT|FOR|GO|GOTO|GROUP|HAND|HOLD|IF|INDEPENDENT|MOD|MOVE|NEAR|NOABORT|NOMESSAGE|NOPAUSE|NOT|NOWAIT|OPEN|OR|PAUSE|POWERUP|PULSE|PURGE|READ|RELATIVE|RELAX|RELEASE|REPEAT|RESTORE|RESUME|RETURN|SELECT|SIGNAL|STOP|THEN|TIME|TIMER|TO|TPENABLE|UNHOLD|UNPAUSE|UNTIL|USING|VIA|WAIT|WHEN|WHILE|WITH|WRITE|STRUCTURE|ENDSTRUCTURE|BEGIN|VAR|CONST|TYPE|PROGRAM|ROUTINE|SHADOW)\\b",
      "name": "keyword.control.karel"
    },
    "builtin": {
      "match": "\\b(ABS|ACOS|ACT_SCREEN|ACT_TBL|ADD_BYNAMEPC|ADD_DICT|ADD_INTPC|ADD_REALPC|ADD_STRINGPC|APPEND_NODE|APPEND_QUEUE|APPROACH|ARRAY_LEN|ASIN|ATAN2|ATT_WINDOW_D|ATT_WINDOW_S|AVL_POS_NUM|BYNAME|BYTES_AHEAD|BYTES_LEFT|CALL_PROG|CALL_PROGLIN|CANCEL_FILE|CHECK_DICT|CHECK_EPOS|CHECK_NAME|CHR|CLEAR|CLEAR_SEMA|CLOSE_TPE|CLR_IO_STAT|CLR_PORT_SIM|CLR_POS_REG|CNC_DYN_DISB|CNC_DYN_DISE|CNC_DYN_DISI|CNC_DYN_DISP|CNC_DYN_DISR|CNC_DYN_DISS|CNCL_STP_MTN|CNV_CNF_STRG|CNV_CONF_STR|CNV_INT_STR|CNV_JPOS_REL|CNV_REAL_STR|CNV_REL_JPOS|CNV_STR_CONF|CNV_STR_INT|CNV_STR_REAL|CNV_STR_TIME|CNV_TIME_STR|COMPARE_FILE|CONT_TASK|COPY_FILE|COPY_PATH|COPY_QUEUE|COPY_TPE|COS|CREATE_TPE|CREATE_VAR|CURJPOS|CURPOS|CURR_PROG|DAQ_CHECKP|DAQ_REGPIPE|DAQ_START|DAQ_STOP|DAQ_UNREG|DAQ_WRITE|DEF_SCREEN|DEF_WINDOW|DELETE_FILE|DELETE_NODE|DELETE_QUEUE|DELETE_TPE|DET_WINDOW|DISCTRL_ALPH|DISCTRL_FORM|DISCTRL_LIST|DISCTRL_PLMN|DISCTRL_SBMN|DISCTRL_TBL|DISMOUNT_DEV|DOSFILE_INF|ERR_DATA|EXP|FILE_LIST|FORCE_LINK|FORCE_SPMENU|FORMAT_DEV|FRAME|GET_ATTR_PRG|GET_FILE_POS|GET_JPOS_REG|GET_JPOS_TPE|GET_PORT_ASG|GET_PORT_ATR|GET_PORT_CMT|GET_PORT_MOD|GET_PORT_SIM|GET_PORT_VAL|GET_POS_FRM|GET_POS_REG|GET_POS_TPE|GET_POS_TYP|GET_PREG_CMT|GET_QUEUE|GET_REG|GET_REG_CMT|GET_SREG_CMT|GET_STR_REG|GET_TIME|GET_TPE_CMT|GET_TPE_PRM|GET_TSK_INFO|GET_USEC_SUB|GET_USEC_TIM|GET_VAR|IN_RANGE|INDEX|INI_DYN_DISB|INI_DYN_DISE|INI_DYN_DISI|INI_DYN_DISP|INI_DYN_DISR|INI_DYN_DISS|INIT_QUEUE|INIT_TBL|INSERT_NODE|INSERT_QUEUE|INV|IO_MOD_TYPE|IO_STATUS|J_IN_RANGE|JOINT2POS|KCL|KCL_NO_WAIT|KCL_STATUS|LN|LOAD|LOAD_STATUS|LOCK_GROUP|MIRROR|MODIFY_QUEUE|MOTION_CTL|MOUNT_DEV|MOVE_FILE|MSG_CONNECT|MSG_DISCO|MSG_PING|NODE_SIZE|OPEN_TPE|ORD|ORIENT|PATH_LEN|PAUSE_TASK|PEND_SEMA|PIPE_CONFIG|POS|POS2JOINT|POS_REG_TYPE|POST_ERR|POST_ERR_L|POST_SEMA|PRINT_FILE|PROG_BACKUP|PROG_CLEAR|PROG_LIST|PROG_RESTORE|PURGE_DEV|READ_DICT|READ_DICT_V|READ_KB|REMOVE_DICT|RENAME_FILE|RENAME_TPE|RENAME_VAR|RESET|RETURN|ROUND|RUN_TASK|SAVE|SAVE_DRAM|SELECT_TPE|SEMA_COUNT|SEND_DATAPC|SEND_EVENTPC|SET_ATTR_PRG|SET_CURSOR|SET_EPOS_REG|SET_EPOS_TPE|SET_FILE_ATR|SET_FILE_POS|SET_INT_REG|SET_JPOS_REG|SET_JPOS_TPE|SET_LANG|SET_PERCH|SET_PORT_ASG|SET_PORT_ATR|SET_PORT_CMT|SET_PORT_MOD|SET_PORT_SIM|SET_PORT_VAL|SET_POS_REG|SET_POS_TPE|SET_PREG_CMT|SET_REAL_REG|SET_REG_CMT|SET_SREG_CMT|SET_STR_REG|SET_TIME|SET_TPE_CMT|SET_TRNS_TPE|SET_TSK_ATTR|SET_TSK_NAME|SET_VAR|SIN|SQRT|STR_LEN|SUB_STR|TAN|TRANSLATE|TRUNC|UNINIT|UNLOCK_GROUP|UNPOS|VAR_INFO|VAR_LIST|VOL_SPACE|VREG_FND_POS|VREG_OFFSET|WAIT_FOR|WRITE_DICT|WRITE_DICT_V|XML_ADDTAG|XML_GETDATA|XML_REMTAG|XML_SCAN|XML_SETVAR|ABORT_TASK|DEL_INST_TPE|POP_KEY_RD|PUSH_KEY_RD|QUEUE_ATTACH|RENAME_VARS|RGET_PORTCMT|RGET_PORTSIM|RGET_PORTVAL|RGET_PREGCMT|RGET_REG|RGET_REG_CMT|RGET_SREGCMT|RGET_STR_REG|RMCN_ALERT|RMCN_SEND|RNUMREG_RECV|RNUMREG_SEND|RPREG_RECV|RPREG_SEND|RSET_INT_REG|RSET_PORTCMT|RSET_PORTSIM|RSET_PORTVAL|RSET_PREGCMT|RSET_REALREG|RSET_REG_CMT|RSET_SREGCMT|RSET_STR_REG|V_ACQ_VAMAP|V_ADJ_2D|V_CAM_CALIB|V_CAM_CHECK|V_CLR_VAMAP|V_CSAPI_GETVALUE|V_CSAPI_NUMSET|V_CSAPI_RESETDATA|V_CSAPI_SAVEDATA|V_CSAPI_SETVALUE|V_CSAPI_TESTRUN|V_DISPLAY4D|V_FIND_VIEW|V_FIND_VLINE|V_GET_FOUND|V_GET_OFFSET|V_GET_PASSFL|V_GET_READ|V_GET_VPARAM|V_IRCONNECT|V_LED_OFF|V_LED_ON|V_OVERRIDE|V_RUN_FIND|V_SAVE_IMREG|V_SET_REF|V_SNAP_VIEW|VT_ACK_QUEUE|VT_CLR_QUEUE|VT_DELETE_PQ|VT_GET_AREID|VT_GET_FOUND|VT_GET_LINID|VT_GET_PFRT|VT_GET_QUEUE|VT_GET_TIME|VT_GET_TRYID|VT_PUT_QUE2|VT_PUT_QUEUE|VT_READ_PQ|VT_SET_FLAG|VT_SET_LDBAL|VT_WRITE_PQ)\\b(?=\\s*\\()",
      "name": "support.function.builtin.karel"
    },
    "call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "name": "entity.name.function.call.karel"
    },
    "number": {
      "match": "\\b\\d+(\\.\\d*)?([eE][+-]?\\d+)?\\b",
      "name": "constant.numeric.karel"
    },
    "operator": {
      "match": "<>|<=|>=|>=<|:=|=|<|>|\\+|-|\\*|/|#|@|\\^|:",
      "name": "keyword.operator.karel"
    },
    "identifier": {
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
      "name": "variable.other.karel"
    }
  }
}
